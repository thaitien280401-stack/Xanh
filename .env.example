# ─── Domain & HTTPS ───────────────────────────────────────────
# Your production domain name (used by nginx + Let's Encrypt)
DOMAIN=yourdomain.com
# Email address for Let's Encrypt expiry notifications
CERTBOT_EMAIL=you@yourdomain.com

# ─── GHCR Image Registry ──────────────────────────────────────
# Full GHCR image paths built by the CD pipeline.
# Change these only if you host images in a different registry/org.
BACKEND_IMAGE=ghcr.io/thaitien280401-stack/xanh/xanh-backend
FRONTEND_IMAGE=ghcr.io/thaitien280401-stack/xanh/xanh-frontend
# Optional: pin to a specific image tag (defaults to latest)
IMAGE_TAG=latest

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=xanh_vocab
POSTGRES_USER=xanh
POSTGRES_PASSWORD=changeme

# ─── Spring Boot ──────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/xanh_vocab
SPRING_DATASOURCE_USERNAME=xanh
SPRING_DATASOURCE_PASSWORD=changeme

# ─── JWT (minimum 256 bits — generate with: openssl rand -base64 32) ──
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-256-bits
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── Kafka ────────────────────────────────────────────────────
# Use the internal Docker network port (29092), not the external one (9092).
# 9092 is only for clients connecting from outside the Docker network.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ─── External Vocabulary API ──────────────────────────────────
EXTERNAL_VOCAB_API_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# ─── CORS: must match the domain above ────────────────────────
FRONTEND_URL=https://yourdomain.com
